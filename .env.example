# ===========================================
# CONFIGURACIÓN WORDPRESS DOCKER - PLANTILLA
# ===========================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env.dev para desarrollo
# 2. Copia este archivo como .env.prod para producción
# 3. Ajusta los valores según tu entorno
#
# USO:
# - Desarrollo: docker-compose --env-file .env.dev --profile development up -d
# - Producción: docker-compose --env-file .env.prod --profile production up -d
#

# --- CONFIGURACIÓN DE MYSQL ---
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wordpress_user
MYSQL_PASSWORD=your_secure_password

# --- CONFIGURACIÓN DE PUERTOS (SOLO DESARROLLO) ---
# Solo necesario para desarrollo, producción usa Traefik
WORDPRESS_PORT=9000
PHPMYADMIN_PORT=9001

# --- CONFIGURACIÓN DE TIMEZONE ---
TIMEZONE=America/Lima

# --- CONFIGURACIÓN DE WORDPRESS ---
WP_TABLE_PREFIX=wp_
WP_DEBUG=1
WORDPRESS_CONFIG_EXTRA=define('WP_HOME','http://localhost:9000'); define('WP_SITEURL','http://localhost:9000');

# --- CONFIGURACIÓN DE DOMINIO ---
# Desarrollo: localhost
# Producción: tu-dominio.com
DOMAIN_NAME=localhost